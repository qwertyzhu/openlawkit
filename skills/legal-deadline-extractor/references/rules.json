      "rule_id": "CN-LAB-ARBITRATION-FINAL-AWARD-EMPLOYER-SETASIDE-30CD",
      "title": "终局劳动仲裁裁决用人单位申请撤销期限",
      "procedure_type": "labor_arbitration",
      "event_type": "labor_award_received",
      "conditions": {
        "participant_role": {"equals": "employer"},
        "classifiers.award_type": {"equals": "final"},
        "classifiers.remedy": {"equals": "set_aside"}
      },
      "duration": {"value": 30, "unit": "calendar_days"},
      "calculation": {"exclude_trigger_day": true, "roll_forward_if_nonworking": true},
      "requires_review": true,
      "review_reason": "只有符合法定撤销事由且向有管辖权的中级人民法院申请时才适用；本工具不判断撤销事由或管辖。",
