    {
      "rule_id": "CN-LAB-ARBITRATION-NONFINAL-AWARD-LAWSUIT-15CD",
      "title": "非终局劳动仲裁裁决不服起诉期限",
      "procedure_type": "labor_arbitration",
      "event_type": "labor_award_received",
      "conditions": {
        "participant_role": {"one_of": ["employee", "employer"]},
        "classifiers.award_type": {"equals": "non_final"}
      },
      "duration": {"value": 15, "unit": "calendar_days"},
      "calculation": {"exclude_trigger_day": true, "roll_forward_if_nonworking": true},
      "requires_review": false,
      "review_reason": null,
      "verification": {"status": "verified", "verified_at": "2026-08-12"},
      "official_sources": [
