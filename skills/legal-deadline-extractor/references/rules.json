    {
      "rule_id": "CN-CIVIL-ENFORCEMENT-APPLICATION-2Y",
      "title": "申请执行期间",
      "procedure_type": "civil_enforcement",
      "event_type": "enforcement_limitation_trigger",
      "conditions": {
        "classifiers.trigger_basis": {"one_of": ["performance_period_last_day", "installment_plan_last_day", "legal_instrument_effective_date"]}
      },
      "duration": {"value": 2, "unit": "years"},
      "calculation": {"exclude_trigger_day": true, "roll_forward_if_nonworking": true},
      "requires_review": true,
      "review_reason": "申请执行期间可能发生中止或中断；分期履行依现行法从最后一期履行期限届满之日起计算。这里仅给出未发生中止、中断时的机械基准日。",
      "verification": {"status": "verified", "verified_at": "2026-08-12"},
