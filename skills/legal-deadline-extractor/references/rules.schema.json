{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenLawKit legal deadline rule pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_pack_version", "jurisdiction", "verified_at", "rules"],
  "properties": {
    "rule_pack_version": {"type": "string", "minLength": 1},
    "jurisdiction": {"const": "CN"},
    "verified_at": {"type": "string", "format": "date"},
    "scope_note": {"type": "string"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "title", "procedure_type", "event_type", "conditions", "duration", "calculation", "verification", "official_sources"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "procedure_type": {"type": "string", "minLength": 1},
          "event_type": {"type": "string", "minLength": 1},
          "conditions": {"type": "object"},
          "duration": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
              "value": {"type": "integer", "minimum": 1},
              "unit": {"enum": ["calendar_days", "working_days", "years"]}
            }
          },
          "calculation": {
            "type": "object",
            "required": ["exclude_trigger_day", "roll_forward_if_nonworking"],
            "properties": {
              "exclude_trigger_day": {"const": true},
              "roll_forward_if_nonworking": {"type": "boolean"}
            }
          },
          "requires_review": {"type": "boolean"},
          "review_reason": {"type": ["string", "null"]},
          "verification": {
            "type": "object",
            "required": ["status", "verified_at"],
            "properties": {
              "status": {"enum": ["verified", "unverified"]},
              "verified_at": {"type": "string", "format": "date"}
            }
          },
          "official_sources": {"type": "array", "minItems": 1}
        }
      }
    }
  }
}
