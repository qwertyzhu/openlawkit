{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlawkit.example/schemas/legal-deadline-facts.schema.json",
  "title": "OpenLawKit legal deadline extraction facts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matter_id", "events"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "matter_id": {"type": "string", "minLength": 1},
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "document_type"],
      "properties": {
        "file_name": {"type": "string", "minLength": 1},
        "document_type": {"type": "string", "minLength": 1},
        "issuing_body": {"type": ["string", "null"]},
        "case_number": {"type": ["string", "null"]},
        "is_fictional_example": {"type": "boolean"}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_type",
          "procedure_type",
          "participant_role",
          "trigger_date",
          "trigger_date_status",
          "original_excerpt",
          "source_locator",
          "rule_id",
          "confidence"
        ],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "event_type": {"type": "string", "minLength": 1},
          "procedure_type": {"type": "string", "minLength": 1},
          "participant_role": {"type": ["string", "null"]},
          "classifiers": {
            "type": "object",
            "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
          },
          "trigger_date": {
            "oneOf": [
              {"type": "string", "format": "date"},
              {"type": "null"}
            ]
          },
          "trigger_date_status": {
            "enum": ["confirmed", "uncertain", "missing"]
          },
          "original_excerpt": {"type": "string", "minLength": 1},
          "source_locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file_name", "location"],
            "properties": {
              "file_name": {"type": "string", "minLength": 1},
              "location": {"type": "string", "minLength": 1},
              "page": {"type": ["integer", "null"], "minimum": 1},
              "paragraph": {"type": ["integer", "null"], "minimum": 1}
            }
          },
          "rule_id": {"type": ["string", "null"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
